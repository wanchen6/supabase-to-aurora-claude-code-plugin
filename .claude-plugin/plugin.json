{
  "name": "supabase-to-aurora",
  "version": "1.0.0",
  "description": "Migrate PostgreSQL databases from Supabase to Amazon Aurora PostgreSQL — assessment, provisioning, data migration, validation, cutover, and optimization",
  "author": {
    "name": "AWS",
    "url": "https://aws.amazon.com"
  },
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "awslabs-postgres-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.postgres-mcp-server@latest", "--allow_write_query"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "aws-pricing-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.aws-pricing-mcp-server@latest"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    }
  }
}
